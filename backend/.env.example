# Copy this file to backend/.env and fill it in. backend/.env is gitignored - do not commit real values.
# See SELF_HOSTING.md.

# Postgres connection string. Under docker compose the host is "db" and the password is the one in
# postgres.env. For a backend running on the host against the dev compose file, use 127.0.0.1 instead.
DATABASE_URL=postgres://gas:CHANGE_ME@db:5432/gas

# Signs the session cookie. Any long random string, e.g. `openssl rand -hex 32`. Changing it logs
# every bot out, but they just sign back in.
EXPRESS_SESSION_SECRET=

# Signs the bearer tokens from POST /api/v2/login. A different long random string.
JWT_SECRET=

# The port the API listens on.
EXPRESS_PORT=4000

# Comma-separated origins allowed to make credentialed requests. Keep "https://tauri.localhost", that
# is the GA desktop client. Add your own site's origin too.
CORS_ORIGINS=http://localhost:3000,http://localhost:4000,http://localhost:5173,https://tauri.localhost

# The website's address. Password reset emails link to <SITE_URL>/reset-password.
SITE_URL=http://localhost:5173

# Outgoing mail for password recovery, from any SMTP provider. Leave SMTP_HOST empty to skip sending
# and write the reset link to the backend log instead.
SMTP_HOST=
SMTP_PORT=587
# true for port 465 (implicit TLS). false for 587, which upgrades with STARTTLS.
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Granblue Automation Statistics <no-reply@example.com>

# How the API treats a request that carries no valid credentials.
#   observe - resolve the caller, record what they presented, reject nothing. The default.
#   enforce - record the same thing, and reject anonymous callers with a 401.
#   off     - resolve the caller, record nothing, reject nothing.
# See the auth enforcement section of SELF_HOSTING.md before changing this. The old guard never
# rejected anything, so the bots may not be authenticating at all.
AUTH_ENFORCEMENT=observe

# Set to true when the API sits behind a reverse proxy, so the rate limiters count the real caller
# rather than the proxy.
TRUST_PROXY=false

# Submissions with an appVersion are checked against the current bot release. Set this to false to
# skip the check, which also means the API makes no outbound requests.
VERSION_GATE_ENABLED=true

# Where that check reads the current versions from. Leave unset to use the upstream bot repositories.
GA_UPDATE_JSON_URL=
GAA_UPDATE_XML_URL=
