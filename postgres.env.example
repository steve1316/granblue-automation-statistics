# Copy this file to postgres.env and fill it in. postgres.env is gitignored - do not commit real values.
# The Postgres container only reads these the first time it starts with an empty data volume.

POSTGRES_USER=gas
POSTGRES_DB=gas

# Any long random string, e.g. `openssl rand -hex 24`. DATABASE_URL in backend/.env must use the same value.
POSTGRES_PASSWORD=
