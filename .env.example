# Copy this file to .env.development (for `yarn start`) and .env.production (for `yarn build`).
# Both are gitignored - do not commit real values.
#
# Every value here is compiled into the JavaScript bundle when you build. Changing one means
# rebuilding the frontend, not restarting it.

# Where the API server lives. The website talks only to the API, never to the database.
VITE_API_URL=http://localhost:4000
