# Copy this file to mail/.env and adjust for your server.
# mail/.env is gitignored - do not commit real values.

# Domains this server is allowed to send from (space-separated).
ALLOWED_SENDER_DOMAINS=granblue-automation-statistics.com

# Generate a DKIM signing key on first start (persisted in ./mail/dkim).
# After the first boot, publish the generated public key as a DNS TXT record - see README.md.
DKIM_AUTOGENERATE=1
